# FactorIA Tool Security Secret
# Valor que ElevenLabs enviará en el header `Authorization: Bearer <secret>`.
# Debe coincidir con el valor configurado en el webhook tool de ElevenLabs (scripts/setup-agent.ts).
FACTORIA_TOOL_SECRET=factoria-secret-token-2026

# ElevenLabs API Key (server-side, NUNCA expuesta al cliente)
ELEVENLABS_API_KEY=

# Agent ID público de ElevenLabs (opcional si usas signed URL server-side)
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# ElevenLabs post-call webhook secret (verificación HMAC del endpoint entrante).
# Lo usa app/api/webhooks/elevenlabs/route.ts. Déjalo vacío para desactivar el endpoint.
ELEVENLABS_WEBHOOK_SECRET=

# URL base de la deployment (para el script de setup y webhook tools)
# Ej: https://localhost:3000 o https://factoria-poc.vercel.app
NEXT_PUBLIC_FACTORIA_BASE_URL=http://localhost:3000

# Demo simulada del widget (true solo para desarrollo sin agente/API key)
NEXT_PUBLIC_FACTORIA_DEMO_MODE=true